# Auto detect text files and perform LF normalization
* text=auto

# Documents
*.md text diff=markdown
*.txt text
*.json text
*.yml text
*.yaml text
*.js text
*.jsx text
*.ts text
*.tsx text
*.html text
*.css text
*.scss text
*.env text
*.env.example text

